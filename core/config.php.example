<?php
// Configurazione runtime di AnySpace. Questo file va copiato FUORI dal
// docroot servito da Apache/Nginx (es. /etc/anyspace/config.php o
// /data/anyspace-config/config.php) e referenziato da core/config.php,
// che lo carica con:
//
//   extract(require '/percorso/fuori/dal/docroot/config.php');
//
// Non lasciare mai questo file (con valori reali) dentro il docroot.
//
// Il percorso di QUESTO file e quello di email_config.php sono definiti come
// costanti (ANYSPACE_CONFIG_FILE e ANYSPACE_EMAIL_CONFIG_FILE) in
// core/config.php: se li sposti, cambia solo quelle due righe.
return array(
    // Connessione al database (MySQL/MariaDB)
    'host'     => 'localhost',
    'dbname'   => 'anyspace',
    'username' => 'anyspace',
    'password' => '',

    // Nome e dominio del sito (usato nei link assoluti e nelle e-mail)
    'siteName'   => 'AnySpace',
    'domainName' => 'tuo-dominio.tld', // puoi usare anche un indirizzo IP

    // Percorso base se il sito NON è servito dalla radice del dominio
    // (es. '' se è su https://tuo-dominio.tld/, '/anyspace' se è su
    // https://tuo-dominio.tld/anyspace/)
    'basePath' => '',

    // ID utente (colonna users.id) che ha accesso al pannello /admin/
    'adminUser' => 1,

    // Registrazione su invito: se true, per iscriversi serve un codice
    // generato dall'amministratore in /admin/invites.php. Si può cambiare
    // anche da quella pagina, senza toccare questo file.
    'requireInvite' => false,

    // Mostra i dettagli degli errori invece della pagina generica: SOLO
    // in sviluppo, mai in produzione
    'debug' => false,
);
